PORT=3000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eve_healthcare

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Redis (caching, rate limiting, webhook retry queue)
REDIS_URL=redis://localhost:6379

# Simulation knobs (0.0 - 1.0)
PAYMENT_FAILURE_RATE=0.2
WEBHOOK_FAILURE_SIMULATION_RATE=0.15
